# Bench harness. `just bench <recipe>` from the repo root.
# A local venv (.venv/) is created on demand for ruff.

venv_dir := source_directory() / ".venv"
venv_python := venv_dir / "bin/python"
ruff_version := "0.17.3"

# List bench recipes.
[private]
default:
    @just --list --unsorted --justfile "{{ source_file() }}"

# Create the venv and install ruff on first use.
_venv:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -x "{{ venv_python }}" ]; then
        uv venv "{{ venv_dir }}"
    fi
    if [ ! -x "{{ venv_dir }}/bin/ruff" ]; then
        uv pip install --python "{{ venv_python }}" "ruff=={{ ruff_version }}"
    fi

# Run the bench unit tests.
test: _venv
    "{{ venv_python }}" -m unittest discover -s "{{ source_directory() }}/tests"

# Lint + format check.
lint: _venv
    "{{ venv_dir }}/bin/ruff" check "{{ source_directory() }}"
    "{{ venv_dir }}/bin/ruff" format --check "{{ source_directory() }}"

# Apply formatting.
format: _venv
    "{{ venv_dir }}/bin/ruff" format "{{ source_directory() }}"

# Serve a backend cell.
server: _venv
    "{{ venv_python }}" "{{ source_directory() }}/bench.py" server

# Run one cell (env-driven; see README).
run *args: _venv
    "{{ venv_python }}" "{{ source_directory() }}/bench.py" run cell {{ args }}

# Prepare a sandbox from an archive.
prepare *args: _venv
    "{{ venv_python }}" "{{ source_directory() }}/bench.py" prepare {{ args }}

# Seed an image repo.
seed-images image_repo images="100" template="" jobs="4": _venv
    "{{ venv_python }}" "{{ source_directory() }}/bench.py" seed --repo "{{ image_repo }}" \
        --count "{{ images }}" --template "{{ template }}" --jobs "{{ jobs }}"

# Record baselines + doc from a run.
extract dir="": _venv
    #!/usr/bin/env bash
    set -euo pipefail
    root="{{ dir }}"
    if [ -z "$root" ]; then
      root="$(ls -dt /tmp/picasu-battery-* /var/tmp/bench-* 2>/dev/null | head -n 1 || true)"
      if [ -z "$root" ]; then echo "no battery output found; pass the battery folder" >&2; exit 2; fi
      echo "using latest battery dir: $root" >&2
    fi
    "{{ venv_python }}" "{{ source_directory() }}/bench.py" battery extract "$root" \
      --baselines-tsv "{{ source_directory() }}/baselines.tsv" \
      --render-md "{{ source_directory() }}/baselines.md"

# Run the gate image counts (100, 200).
battery dir="": _venv
    #!/usr/bin/env bash
    set -euo pipefail
    root="{{ dir }}"
    if [ -z "$root" ]; then root="/tmp/picasu-battery-$(date +%Y%m%d-%H%M%S)"; fi
    echo "battery output: $root" >&2
    "{{ venv_python }}" "{{ source_directory() }}/bench.py" battery run --images 100 --out "$root/100"
    "{{ venv_python }}" "{{ source_directory() }}/bench.py" battery run --images 200 --out "$root/200"

# Compare a report against accepted baselines or another report.
compare base new *args: _venv
    "{{ venv_python }}" "{{ source_directory() }}/bench.py" compare "{{base}}" "{{new}}" {{args}}

# Report per-cell state.
status *args: _venv
    "{{ venv_python }}" "{{ source_directory() }}/bench.py" status {{ args }}

# Remove the on-demand venv.
clean:
    rm -rf "{{ venv_dir }}"
