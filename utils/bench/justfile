# Submodule justfile for the benchmark harness (utils/bench).
# Invoke from the repo root as `just bench <recipe>` (works from any
# directory), or directly: `just -f utils/bench/justfile <recipe>`.
# A local venv (.venv/) is created on demand; ruff is installed into it.

venv_dir := source_directory() / ".venv"
venv_python := venv_dir / "bin/python"
ruff_version := "0.17.3"

# List bench recipes.
[private]
default:
    @just --list --unsorted --justfile "{{ source_file() }}"

# Create the venv and install ruff on first use (idempotent).
_venv:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -x "{{ venv_python }}" ]; then
        uv venv "{{ venv_dir }}"
    fi
    if [ ! -x "{{ venv_dir }}/bin/ruff" ]; then
        uv pip install --python "{{ venv_python }}" "ruff=={{ ruff_version }}"
    fi

# Run the bench unit tests.
test: _venv
    "{{ venv_python }}" -m unittest discover -s "{{ source_directory() }}/tests"

# Lint + format check.
lint: _venv
    "{{ venv_dir }}/bin/ruff" check "{{ source_directory() }}"
    "{{ venv_dir }}/bin/ruff" format --check "{{ source_directory() }}"

# Apply formatting.
format: _venv
    "{{ venv_dir }}/bin/ruff" format "{{ source_directory() }}"

# Serve a backend cell.
server: _venv
    "{{ venv_python }}" "{{ source_directory() }}/launch-backend.py"

# Run a benchmark cell.
workload out image_repo images="100" ncpu="8" build="release" port="5795": _venv
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{ out }}"
    export OUT="{{ out }}" PORT="{{ port }}" BUILD_PROFILE="{{ build }}"
    export NCPU="{{ ncpu }}" IMAGES="{{ images }}"
    export IMAGE_REPO="{{ image_repo }}"
    if [ -n "${IMAGE_PATH:-}" ]; then export IMAGE_PATH; fi
    export REPEATS="${REPEATS:-1}" SCAN_REPEATS="${SCAN_REPEATS:-2}"
    timeout 1200 "{{ venv_python }}" "{{ source_directory() }}/run-cell.py"

# Seed an image repo.
seed-images image_repo images="100" template="" jobs="4": _venv
    "{{ venv_python }}" "{{ source_directory() }}/seed_images.py" --repo "{{ image_repo }}" \
        --count "{{ images }}" --template "{{ template }}" --jobs "{{ jobs }}"

# Extract cell metrics.
extract *args: _venv
    "{{ venv_python }}" "{{ source_directory() }}/extract-bench.py" {{ args }}

# Remove the on-demand venv.
clean:
    rm -rf "{{ venv_dir }}"
