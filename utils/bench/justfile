# Bench harness. `just bench <recipe>` from the repo root.
# A local venv (.venv/) is created on demand for ruff.

venv_dir := source_directory() / ".venv"
venv_python := venv_dir / "bin/python"
ruff_version := "0.17.3"

# List bench recipes.
[private]
default:
    @just --list --unsorted --justfile "{{ source_file() }}"

# Create the venv and install ruff on first use.
_venv:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -x "{{ venv_python }}" ]; then
        uv venv "{{ venv_dir }}"
    fi
    if [ ! -x "{{ venv_dir }}/bin/ruff" ]; then
        uv pip install --python "{{ venv_python }}" "ruff=={{ ruff_version }}"
    fi

# Run the bench unit tests.
test: _venv
    "{{ venv_python }}" -m unittest discover -s "{{ source_directory() }}/tests"

# Lint + format check.
lint: _venv
    "{{ venv_dir }}/bin/ruff" check "{{ source_directory() }}"
    "{{ venv_dir }}/bin/ruff" format --check "{{ source_directory() }}"

# Apply formatting.
format: _venv
    "{{ venv_dir }}/bin/ruff" format "{{ source_directory() }}"

# Serve a backend cell.
server: _venv
    "{{ venv_python }}" "{{ source_directory() }}/bench.py" server

# Run one cell (env-driven; see README).
run *args: _venv
    "{{ venv_python }}" "{{ source_directory() }}/bench.py" run cell {{ args }}

# Prepare a sandbox from a canonical archive.
prepare *args: _venv
    "{{ venv_python }}" "{{ source_directory() }}/bench.py" prepare {{ args }}

# Run the preflight checklist.
preflight *args: _venv
    "{{ venv_python }}" "{{ source_directory() }}/bench.py" preflight {{ args }}

# Seed an image repo.
seed-images image_repo images="100" template="" jobs="4": _venv
    "{{ venv_python }}" "{{ source_directory() }}/bench.py" seed --repo "{{ image_repo }}" \
        --count "{{ images }}" --template "{{ template }}" --jobs "{{ jobs }}"

# Extract a battery parent as JSON + report.
extract parent out="": _venv
    "{{ venv_python }}" "{{ source_directory() }}/bench.py" battery extract "{{ parent }}" --out "{{ out }}"

# Run a pinned battery and write its report.
battery level="gate" out="": _venv
    "{{ venv_python }}" "{{ source_directory() }}/bench.py" battery run "{{ level }}" --out "{{ out }}"

# Compare a battery report against the checked-in baseline bands.
battery-check report baselines="": _venv
    "{{ venv_python }}" "{{ source_directory() }}/bench.py" battery check "{{ report }}" --baselines "{{ baselines }}"

# Report per-cell state under a battery parent.
status *args: _venv
    "{{ venv_python }}" "{{ source_directory() }}/bench.py" status {{ args }}


# Remove the on-demand venv.
clean:
    rm -rf "{{ venv_dir }}"
