# Submodule justfile for the quint/spec tooling (utils/quint).
# Invoke from the repo root as `just quint <recipe>` (works from any
# directory), or directly: `just -f utils/quint/justfile <recipe>`.

root := source_directory() / ".." / ".."
pipeline_dir := source_directory() / "pipeline"
docs_report  := source_directory() / ".." / ".." / "docs" / "eventual-consistency.md"

# List quint recipes.
[private]
default:
    @just --list --unsorted --justfile "{{ source_file() }}"

# Quint binary via the root install recipe (idempotent; nested `just`
# needs an explicit working directory — the nearest justfile from here is
# the module's own).
[private]
_install-quint:
    just -d "{{ root }}" install quint

# Static self-checks: prettier over the layer + typecheck the model entry.
[group('quint')]
lint: _install-quint
    cd "{{ root }}/frontend" && npx --no-install prettier --check --no-error-on-unmatched-pattern '../utils/quint/**/*.md' '../utils/quint/coverage/**/*.ts'
    cd "{{ root }}/frontend" && npx --no-install tsc --noEmit -p ../utils/quint/coverage/tsconfig.json
    quint typecheck "{{ pipeline_dir }}/entry-canonical.qnt"
    quint typecheck "{{ pipeline_dir }}/entry-reduced-paths.qnt"
    quint typecheck "{{ pipeline_dir }}/entry-reduced.qnt"

# Apply formatting.
[group('quint')]
format:
    cd "{{ root }}/frontend" && npx --no-install prettier --write --no-error-on-unmatched-pattern '../utils/quint/**/*.md'

# Fast spec gates: run on any code change (no model runs). The run sources
# named here feed the doc status line; they are the files `test` executes.
[group('quint')]
check:
    node "{{ source_directory() }}/coverage/bin/check.ts" all "{{ pipeline_dir }}" "{{ docs_report }}" merged.qnt

# Run the model entry at the standard sample count (10k per run).
[group('quint')]
test: _install-quint
    quint test "{{ pipeline_dir }}/entry-canonical.qnt"

# Deep model runs, elevated sample counts (nightly; tens of minutes).
[group('quint')]
fulltest: _install-quint
    #!/usr/bin/env bash
    set -euo pipefail
    quint test --max-samples 100000 "{{ pipeline_dir }}/entry-canonical.qnt"

# Advisory (nightly): the partitioned inductive-invariant check for the
# inductive lane (see utils/quint/inductive/tools/partitioned-typeok.sh
# and the plan record). Not a merge gate.
[group('quint')]
inductive-partitioned: _install-quint
    bash "{{ source_directory() }}/inductive/tools/partitioned-typeok.sh" TypeOK 8832

# Regenerate docs/eventual-consistency.md from the catalogs.
[group('quint')]
docs:
    node "{{ source_directory() }}/coverage/bin/check.ts" docs "{{ pipeline_dir }}" "{{ docs_report }}" merged.qnt
    cd "{{ root }}/frontend" && npx --no-install prettier --write --no-error-on-unmatched-pattern "{{ docs_report }}"

# Generated-doc drift gate: regenerate + diff against the committed doc.
[group('quint')]
doc-check:
    node "{{ source_directory() }}/coverage/bin/check.ts" doc-check "{{ pipeline_dir }}" "{{ docs_report }}" merged.qnt

# Checker self-tests: fixtures prove the gates fail when they should.
[group('quint')]
selftest:
    node --test "{{ source_directory() }}/tests/checkers.test.mjs"
