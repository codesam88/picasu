# scripts/deps/versions.env — single source of truth for external system-tool versions.
# Sourced by scripts/deps/*.sh (and scripts/deps-install.sh).
# Format: shell KEY=VALUE, one pin per tool. Bot-bumpable via renovate
# custom-regex on this file. Project deps (Cargo.lock, package-lock.json)
# and language toolchains (rust, node) are intentionally NOT managed here;
# rust/node only carry supported ranges and are check-only.
#
# Placeholders in *_URL_TEMPLATE: {version}, {target}.

# ── Language toolchains (check only, never installed) ─────────────────────────
RUST_SUPPORTED="~1.99"   # rust-toolchain.toml pins 1.99.1; MSRV floor is 1.90
NODE_SUPPORTED="24.x"    # workflows use actions/setup-node node-version "24"

# ── just ──────────────────────────────────────────────────────────────────────
JUST_VERSION="1.59.0"
JUST_URL_TEMPLATE="https://github.com/casey/just/releases/download/{version}/just-{version}-{target}.tar.gz"
JUST_SHA256_LINUX_X86_64="409044617b6f06517c1035e55ca38c8c856ff8b650e41bc2aa1ef82d5903a23e"
JUST_SHA256_LINUX_AARCH64="23871b1702bfd550fb5f901778fd4290ecf2ee034a45a889fbe96d89b188086d"
JUST_SHA256_MACOS_X86_64="036ead9df9bc31dbae9934ae3b4236ed124d0bafcffd33439460ae084d5c9cb7"
JUST_SHA256_MACOS_AARCH64="6574cea774ed4cae12e24b6aa11857de33e80dab4667cf628fd5840df96a2a9d"

