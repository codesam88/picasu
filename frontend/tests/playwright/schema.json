{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI Scenario DSL Schema",
  "description": "Validates UI scenario YAML files in tests/playwright/scenarios/.",
  "$ref": "#/definitions/uiScenario",
  "definitions": {
    "givenDirAlbum": {
      "type": "object",
      "properties": {
        "dir_album": { "type": "string" },
        "id_as": { "type": "string", "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$" }
      },
      "required": ["dir_album"],
      "additionalProperties": false
    },
    "givenPhoto": {
      "type": "object",
      "properties": {
        "photo": { "type": "string" },
        "id_as": { "type": "string", "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$" },
        "format": { "type": "string", "enum": ["jpeg", "png"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "exif_date": { "type": "string" }
      },
      "required": ["photo"],
      "additionalProperties": false
    },
    "givenRemove": {
      "type": "object",
      "properties": {
        "remove": { "type": "string" }
      },
      "required": ["remove"],
      "additionalProperties": false
    },
    "givenMove": {
      "type": "object",
      "properties": {
        "move": { "type": "string" },
        "to": { "type": "string" }
      },
      "required": ["move", "to"],
      "additionalProperties": false
    },
    "givenIndex": {
      "type": "object",
      "properties": {
        "index": { "type": "string", "minLength": 1 }
      },
      "required": ["index"],
      "additionalProperties": false
    },
    "givenEmpty": {
      "type": "object",
      "properties": {
        "empty": { "type": "boolean", "const": true }
      },
      "required": ["empty"],
      "additionalProperties": false
    },
    "givenConfig": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "properties": {
            "read_only_mode": { "type": "boolean" },
            "auth_key": { "type": "string" },
            "fs_notify_watcher": { "type": "boolean" },
            "allow_registration": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "required": ["config"],
      "additionalProperties": false
    },
    "givenUser": {
      "type": "object",
      "properties": {
        "user": {
          "type": "object",
          "properties": {
            "user_id": { "type": "string", "minLength": 1 },
            "password": { "type": "string", "minLength": 1 },
            "admin": { "type": "boolean" }
          },
          "required": ["user_id", "password"],
          "additionalProperties": false
        }
      },
      "required": ["user"],
      "additionalProperties": false
    },
    "givenInvite": {
      "type": "object",
      "properties": {
        "invite": {
          "type": "object",
          "properties": {
            "username": { "type": "string", "minLength": 1 },
            "expires_in_hours": { "type": "integer" }
          },
          "additionalProperties": false
        },
        "id_as": { "type": "string", "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$" }
      },
      "required": ["invite"],
      "additionalProperties": false
    },
    "givenCliUser": {
      "type": "object",
      "properties": {
        "cli_user": {
          "type": "object",
          "properties": {
            "user_id": { "type": "string", "minLength": 1 },
            "password": { "type": "string", "minLength": 1 },
            "admin": { "type": "boolean" }
          },
          "required": ["user_id", "password"],
          "additionalProperties": false
        }
      },
      "required": ["cli_user"],
      "additionalProperties": false
    },
    "givenPhotoRaw": {
      "type": "object",
      "properties": {
        "photo_raw": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "enum": ["jpeg", "png"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "required": ["photo_raw"],
      "additionalProperties": false
    },
    "givenSourceFile": {
      "type": "object",
      "properties": {
        "source_file": { "type": "string", "minLength": 1 },
        "fixture": {
          "type": "string",
          "minLength": 1,
          "description": "Id of a pinned fixture in utils/snapfab/capabilities.json, for the formats snapfab cannot encode. Mutually exclusive with `format`."
        },
        "format": { "type": "string", "enum": ["jpeg", "png"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "id_as": { "type": "string", "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$" }
      },
      "required": ["source_file"],
      "additionalProperties": false,
      "not": {
        "required": ["fixture", "format"]
      }
    },
    "givenItem": {
      "oneOf": [
        { "$ref": "#/definitions/givenDirAlbum" },
        { "$ref": "#/definitions/givenPhoto" },
        { "$ref": "#/definitions/givenPhotoRaw" },
        { "$ref": "#/definitions/givenSourceFile" },
        { "$ref": "#/definitions/givenEmpty" },
        { "$ref": "#/definitions/givenRemove" },
        { "$ref": "#/definitions/givenConfig" },
        { "$ref": "#/definitions/givenUser" },
        { "$ref": "#/definitions/givenInvite" },
        { "$ref": "#/definitions/givenCliUser" },
        { "$ref": "#/definitions/givenMove" },
        { "$ref": "#/definitions/givenIndex" }
      ]
    },
    "uiWhenNavigate": {
      "type": "object",
      "properties": {
        "navigate": { "type": "string" }
      },
      "required": ["navigate"],
      "additionalProperties": false
    },
    "uiWhenClick": {
      "type": "object",
      "properties": {
        "click": { "type": "string", "pattern": "^[a-z]+/" }
      },
      "required": ["click"],
      "additionalProperties": false
    },
    "uiWhenFill": {
      "type": "object",
      "properties": {
        "fill": { "type": "string", "pattern": "^[a-z]+/" },
        "value": { "type": "string" }
      },
      "required": ["fill", "value"],
      "additionalProperties": false
    },
    "uiWhenSelect": {
      "type": "object",
      "properties": {
        "select": { "type": "string", "pattern": "^[a-z]+/" },
        "option": { "type": "string" }
      },
      "required": ["select", "option"],
      "additionalProperties": false
    },
    "uiWhenSubmit": {
      "type": "object",
      "properties": {
        "submit": { "type": "boolean", "const": true }
      },
      "required": ["submit"],
      "additionalProperties": false
    },
    "uiWhenWait": {
      "type": "object",
      "properties": {
        "wait.ms": { "type": "integer", "minimum": 1 }
      },
      "required": ["wait.ms"],
      "additionalProperties": false
    },
    "uiWhenClickText": {
      "type": "object",
      "properties": {
        "click.text": { "type": "string" }
      },
      "required": ["click.text"],
      "additionalProperties": false
    },
    "uiWhenClickIcon": {
      "type": "object",
      "properties": {
        "click.icon": { "type": "string" }
      },
      "required": ["click.icon"],
      "additionalProperties": false
    },
    "uiWhenClickFirst": {
      "type": "object",
      "properties": {
        "click.first": { "type": "boolean", "const": true }
      },
      "required": ["click.first"],
      "additionalProperties": false
    },
    "uiWhenClickSelectFirst": {
      "type": "object",
      "properties": {
        "click.select_first": { "type": "boolean", "const": true }
      },
      "required": ["click.select_first"],
      "additionalProperties": false
    },
    "uiWhenClickSelectText": {
      "type": "object",
      "properties": {
        "click.select_text": { "type": "string" }
      },
      "required": ["click.select_text"],
      "additionalProperties": false
    },
    "uiWhenClickTestId": {
      "type": "object",
      "properties": {
        "click.testid": { "type": "string" }
      },
      "required": ["click.testid"],
      "additionalProperties": false
    },
    "uiWhenUploadFiles": {
      "type": "object",
      "properties": {
        "upload.files": {
          "type": "object",
          "properties": {
            "trigger": { "type": "string" },
            "files": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          },
          "required": ["trigger", "files"],
          "additionalProperties": false
        }
      },
      "required": ["upload.files"],
      "additionalProperties": false
    },
    "uiWhenSetAutoRename": {
      "type": "object",
      "properties": {
        "set.auto_rename": { "type": "boolean" }
      },
      "required": ["set.auto_rename"],
      "additionalProperties": false
    },
    "uiWhenReload": {
      "type": "object",
      "properties": {
        "reload": { "type": "boolean", "const": true }
      },
      "required": ["reload"],
      "additionalProperties": false
    },
    "uiWhenClickMenu": {
      "type": "object",
      "properties": {
        "click.menu": { "type": "string", "minLength": 1 }
      },
      "required": ["click.menu"],
      "additionalProperties": false
    },
    "uiWhenLogin": {
      "type": "object",
      "properties": {
        "login": {
          "type": "object",
          "properties": {
            "user": { "type": "string", "minLength": 1 },
            "password": { "type": "string", "minLength": 1 }
          },
          "required": ["user", "password"],
          "additionalProperties": false
        }
      },
      "required": ["login"],
      "additionalProperties": false
    },
    "uiWhenIndex": {
      "type": "object",
      "properties": {
        "index": { "type": "string", "minLength": 1 }
      },
      "required": ["index"],
      "additionalProperties": false
    },
    "uiWhenItem": {
      "oneOf": [
        { "$ref": "#/definitions/uiWhenNavigate" },
        { "$ref": "#/definitions/uiWhenClick" },
        { "$ref": "#/definitions/uiWhenFill" },
        { "$ref": "#/definitions/uiWhenSelect" },
        { "$ref": "#/definitions/uiWhenSubmit" },
        { "$ref": "#/definitions/uiWhenWait" },
        { "$ref": "#/definitions/uiWhenClickText" },
        { "$ref": "#/definitions/uiWhenClickIcon" },
        { "$ref": "#/definitions/uiWhenClickFirst" },
        { "$ref": "#/definitions/uiWhenClickSelectFirst" },
        { "$ref": "#/definitions/uiWhenClickSelectText" },
        { "$ref": "#/definitions/uiWhenClickTestId" },
        { "$ref": "#/definitions/uiWhenUploadFiles" },
        { "$ref": "#/definitions/uiWhenSetAutoRename" },
        { "$ref": "#/definitions/uiWhenLogin" },
        { "$ref": "#/definitions/uiWhenIndex" },
        { "$ref": "#/definitions/uiWhenReload" },
        { "$ref": "#/definitions/uiWhenClickMenu" }
      ]
    },
    "uiAssertVisible": {
      "type": "object",
      "properties": {
        "ui.visible": { "type": "string", "pattern": "^[a-z]+/" }
      },
      "required": ["ui.visible"],
      "additionalProperties": false
    },
    "uiAssertHidden": {
      "type": "object",
      "properties": {
        "ui.hidden": { "type": "string", "pattern": "^[a-z]+/" }
      },
      "required": ["ui.hidden"],
      "additionalProperties": false
    },
    "uiAssertText": {
      "type": "object",
      "properties": {
        "ui.text": { "type": "string", "pattern": "^[a-z]+/" },
        "contains": { "type": "string" }
      },
      "required": ["ui.text", "contains"],
      "additionalProperties": false
    },
    "uiAssertToast": {
      "type": "object",
      "properties": {
        "ui.toast": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["error", "success", "warning"] },
            "contains": { "type": "string" }
          },
          "required": ["type", "contains"],
          "additionalProperties": false
        }
      },
      "required": ["ui.toast"],
      "additionalProperties": false
    },
    "uiAssertModal": {
      "type": "object",
      "properties": {
        "ui.modal": { "type": "string", "enum": ["open", "closed"] }
      },
      "required": ["ui.modal"],
      "additionalProperties": false
    },
    "uiAssertRoute": {
      "type": "object",
      "properties": {
        "ui.route": { "type": "string" }
      },
      "required": ["ui.route"],
      "additionalProperties": false
    },
    "uiAssertAriaSnapshot": {
      "type": "object",
      "properties": {
        "ui.aria_snapshot": { "type": "string" }
      },
      "required": ["ui.aria_snapshot"],
      "additionalProperties": false
    },
    "uiAssertApiResponse": {
      "type": "object",
      "properties": {
        "api.response": {
          "type": "object",
          "properties": {
            "url": { "type": "string" },
            "status": {
              "oneOf": [{ "type": "integer" }, { "type": "array", "items": { "type": "integer" } }]
            },
            "method": { "type": "string", "enum": ["GET", "POST", "PUT", "DELETE"] },
            "body": true,
            "json": { "type": "object" },
            "json_absent": { "type": "string" },
            "header": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "gt": { "type": "number" },
                "equals": { "type": ["string", "number"] }
              },
              "required": ["name"],
              "additionalProperties": false,
              "anyOf": [{ "required": ["gt"] }, { "required": ["equals"] }]
            }
          },
          "required": ["url", "status"],
          "additionalProperties": false
        }
      },
      "required": ["api.response"],
      "additionalProperties": false
    },
    "uiAssertTextVisible": {
      "type": "object",
      "properties": {
        "ui.text_visible": { "type": "string" }
      },
      "required": ["ui.text_visible"],
      "additionalProperties": false
    },
    "uiAssertCount": {
      "type": "object",
      "properties": {
        "ui.count": { "type": "string" },
        "equals": { "type": "integer", "minimum": 0 }
      },
      "required": ["ui.count", "equals"],
      "additionalProperties": false
    },
    "uiAssertSidebarVisible": {
      "type": "object",
      "properties": {
        "ui.sidebar_visible": { "type": "string" }
      },
      "required": ["ui.sidebar_visible"],
      "additionalProperties": false
    },
    "uiAssertChipVisible": {
      "type": "object",
      "properties": {
        "ui.chip_visible": { "type": "string" }
      },
      "required": ["ui.chip_visible"],
      "additionalProperties": false
    },
    "uiAssertApiStatuses": {
      "type": "object",
      "properties": {
        "api.statuses": {
          "type": "object",
          "properties": {
            "url": { "type": "string" },
            "equals": { "type": "array", "items": { "type": "integer" } }
          },
          "required": ["url", "equals"],
          "additionalProperties": false
        }
      },
      "required": ["api.statuses"],
      "additionalProperties": false
    },
    "uiAssertDisabled": {
      "type": "object",
      "properties": {
        "ui.disabled": { "type": "string", "pattern": "^[a-z]+/" }
      },
      "required": ["ui.disabled"],
      "additionalProperties": false
    },
    "uiAssertEnabled": {
      "type": "object",
      "properties": {
        "ui.enabled": { "type": "string", "pattern": "^[a-z]+/" }
      },
      "required": ["ui.enabled"],
      "additionalProperties": false
    },
    "uiAssertTextHidden": {
      "type": "object",
      "properties": {
        "ui.text_hidden": { "type": "string" }
      },
      "required": ["ui.text_hidden"],
      "additionalProperties": false
    },
    "uiAssertItem": {
      "oneOf": [
        { "$ref": "#/definitions/uiAssertVisible" },
        { "$ref": "#/definitions/uiAssertHidden" },
        { "$ref": "#/definitions/uiAssertText" },
        { "$ref": "#/definitions/uiAssertToast" },
        { "$ref": "#/definitions/uiAssertModal" },
        { "$ref": "#/definitions/uiAssertRoute" },
        { "$ref": "#/definitions/uiAssertAriaSnapshot" },
        { "$ref": "#/definitions/uiAssertApiResponse" },
        { "$ref": "#/definitions/uiAssertApiStatuses" },
        { "$ref": "#/definitions/uiAssertTextVisible" },
        { "$ref": "#/definitions/uiAssertTextHidden" },
        { "$ref": "#/definitions/uiAssertCount" },
        { "$ref": "#/definitions/uiAssertSidebarVisible" },
        { "$ref": "#/definitions/uiAssertChipVisible" },
        { "$ref": "#/definitions/uiAssertDisabled" },
        { "$ref": "#/definitions/uiAssertEnabled" }
      ]
    },
    "uiStep": {
      "type": "object",
      "properties": {
        "when": {
          "type": "array",
          "items": { "$ref": "#/definitions/uiWhenItem" },
          "minItems": 1
        },
        "assert": {
          "type": "array",
          "items": { "$ref": "#/definitions/uiAssertItem" },
          "minItems": 1
        }
      },
      "required": ["when", "assert"],
      "additionalProperties": false
    },
    "covers": {
      "type": "object",
      "properties": {
        "api": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ui": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "uiScenario": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "covers": { "$ref": "#/definitions/covers" },
        "server": {
          "type": "object",
          "properties": {
            "bootstrap_admin": { "type": "boolean" },
            "login_ip_base_ban_secs": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "given": {
          "type": "array",
          "items": { "$ref": "#/definitions/givenItem" },
          "minItems": 0
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/definitions/uiStep" },
          "minItems": 1
        },
        "when": {
          "type": "array",
          "items": { "$ref": "#/definitions/uiWhenItem" },
          "minItems": 1
        },
        "assert": {
          "type": "array",
          "items": { "$ref": "#/definitions/uiAssertItem" },
          "minItems": 1
        }
      },
      "required": ["name"],
      "oneOf": [{ "required": ["steps"] }, { "required": ["when", "assert"] }],
      "additionalProperties": false
    }
  }
}
