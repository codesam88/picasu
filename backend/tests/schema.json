{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API Scenario DSL Schema",
  "description": "Documents API scenario YAML files in tests/scenarios/ and tests/scenarios/selftest/. No test loads this file: it is editor/CI-facing documentation of the vocabulary backend/src/tests/backend_api.rs accepts, and drift here is invisible to cargo test. Keep it in step with the interpreter.",
  "$ref": "#/definitions/apiScenario",
  "definitions": {
    "givenDirAlbum": {
      "type": "object",
      "properties": {
        "dir_album": {
          "type": "string"
        },
        "id_as": {
          "type": "string",
          "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$"
        }
      },
      "required": ["dir_album"],
      "additionalProperties": false
    },
    "givenPhoto": {
      "type": "object",
      "properties": {
        "photo": {
          "type": "string"
        },
        "id_as": {
          "type": "string",
          "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exif_date": {
          "type": "string"
        },
        "color": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 3,
          "maxItems": 3
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "asset_id_as": {
          "type": "string",
          "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "format": {
          "type": "string",
          "enum": ["jpeg", "png"],
          "default": "jpeg"
        }
      },
      "required": ["photo"],
      "additionalProperties": false
    },
    "givenRawFile": {
      "description": "Write UTF-8 text to a path. Binary content must use `fixture` or one of the byte transforms.",
      "type": "object",
      "properties": {
        "raw_file": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      },
      "required": ["raw_file"],
      "additionalProperties": false
    },
    "givenFixture": {
      "description": "Copy a capability-manifest fixture (digest-verified by snapfab's tests) into IMAGE_HOME.",
      "type": "object",
      "properties": {
        "fixture": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            },
            "destination": {
              "type": "string"
            }
          },
          "required": ["source", "destination"],
          "additionalProperties": false
        },
        "id_as": {
          "type": "string",
          "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "asset_id_as": {
          "type": "string",
          "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$"
        }
      },
      "required": ["fixture"],
      "additionalProperties": false
    },
    "givenDuplicateOf": {
      "description": "Byte-identical copy of a file already placed in the given phase.",
      "type": "object",
      "properties": {
        "duplicate_of": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            },
            "destination": {
              "type": "string"
            }
          },
          "required": ["source", "destination"],
          "additionalProperties": false
        }
      },
      "required": ["duplicate_of"],
      "additionalProperties": false
    },
    "givenTruncateFile": {
      "description": "Keep only the first `bytes` bytes of a file the given phase already created. Applied after photo generation and before the scan, so the indexer sees the truncated bytes.",
      "type": "object",
      "properties": {
        "truncate_file": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": ["path", "bytes"],
          "additionalProperties": false
        }
      },
      "required": ["truncate_file"],
      "additionalProperties": false
    },
    "givenPatchFile": {
      "description": "Replace the first occurrence of find_hex with replace_hex, in place. Applied after photo generation and before the scan. Find and replace must be the same length and the pattern must be present, so a corruption cannot be a silent no-op.",
      "type": "object",
      "properties": {
        "patch_file": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "find_hex": {
              "type": "string",
              "pattern": "^([0-9a-fA-F]{2})+$"
            },
            "replace_hex": {
              "type": "string",
              "pattern": "^([0-9a-fA-F]{2})+$"
            }
          },
          "required": ["path", "find_hex", "replace_hex"],
          "additionalProperties": false
        }
      },
      "required": ["patch_file"],
      "additionalProperties": false
    },
    "givenRemove": {
      "type": "object",
      "properties": {
        "remove": {
          "type": "string"
        }
      },
      "required": ["remove"],
      "additionalProperties": false
    },
    "givenEmpty": {
      "type": "object",
      "properties": {
        "empty": {
          "type": "boolean",
          "const": true
        }
      },
      "required": ["empty"],
      "additionalProperties": false
    },
    "givenConfig": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "properties": {
            "read_only_mode": {
              "type": "boolean"
            },
            "fs_notify_watcher": {
              "type": "boolean"
            },
            "validate_upload_content": {
              "type": "boolean"
            },
            "use_client_timestamp_info": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["config"],
      "additionalProperties": false
    },
    "givenItem": {
      "oneOf": [
        {
          "$ref": "#/definitions/givenDirAlbum"
        },
        {
          "$ref": "#/definitions/givenPhoto"
        },
        {
          "$ref": "#/definitions/givenRawFile"
        },
        {
          "$ref": "#/definitions/givenFixture"
        },
        {
          "$ref": "#/definitions/givenDuplicateOf"
        },
        {
          "$ref": "#/definitions/givenTruncateFile"
        },
        {
          "$ref": "#/definitions/givenPatchFile"
        },
        {
          "$ref": "#/definitions/givenEmpty"
        },
        {
          "$ref": "#/definitions/givenRemove"
        },
        {
          "$ref": "#/definitions/givenConfig"
        }
      ]
    },
    "apiCall": {
      "type": "object",
      "properties": {
        "call": {
          "type": "string",
          "pattern": "^(GET|POST|PUT|DELETE) /"
        },
        "body": {
          "type": "object"
        },
        "raw_body": {
          "description": "Request body as a literal string; wins over `body`.",
          "type": "string"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "auth": {
          "type": "boolean",
          "default": true
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          }
        },
        "capture": {
          "type": "object"
        },
        "calc": {
          "type": "object"
        },
        "then": {
          "type": "array"
        },
        "id_as": {
          "description": "Resolve the asset's content hash by discover_path after this call.",
          "type": "string",
          "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "asset_id_as": {
          "description": "Resolve the asset_id by discover_path after this call.",
          "type": "string",
          "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "discover_path": {
          "type": "string"
        }
      },
      "required": ["call"],
      "additionalProperties": false
    },
    "apiUpload": {
      "type": "object",
      "properties": {
        "upload": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            },
            "filename": {
              "type": "string"
            },
            "target_album": {
              "type": "string"
            },
            "on_conflict": {
              "type": "string",
              "enum": ["rename", "skip"]
            },
            "auto_rename": {
              "type": "boolean"
            },
            "last_modified": {
              "type": "integer"
            },
            "auth": {
              "type": "boolean"
            },
            "content_type": {
              "type": "string"
            }
          },
          "required": ["file"],
          "additionalProperties": false
        },
        "then": {
          "type": "array"
        },
        "id_as": {
          "type": "string",
          "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "discover_path": {
          "type": "string"
        }
      },
      "required": ["upload"],
      "additionalProperties": false
    },
    "apiThenResponseStatus": {
      "type": "object",
      "properties": {
        "response.status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        }
      },
      "required": ["response.status"],
      "additionalProperties": false
    },
    "apiThenResponseStatusNot": {
      "type": "object",
      "properties": {
        "response.status_not": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        }
      },
      "required": ["response.status_not"],
      "additionalProperties": false
    },
    "apiThenResponseField": {
      "description": "One `response.json.<path>` equality assertion. The path allows `:` and `-` inside segments because ffprobe-derived video exifVec keys are literally named e.g. `TAG:major_brand` and `TAG:compatible_brands`.",
      "type": "object",
      "patternProperties": {
        "^response\\.[a-zA-Z_][a-zA-Z0-9_.:-]*$": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            },
            {
              "type": "object"
            },
            {
              "type": "array"
            }
          ]
        }
      },
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false
    },
    "apiThenArrayMinCounts": {
      "type": "object",
      "properties": {
        "array_min_counts": {
          "type": "object"
        }
      },
      "required": ["array_min_counts"],
      "additionalProperties": false
    },
    "apiThenArrayWhere": {
      "type": "object",
      "properties": {
        "array_where": {
          "type": "object"
        }
      },
      "required": ["array_where"],
      "additionalProperties": false
    },
    "apiThenCompare": {
      "type": "object",
      "properties": {
        "compare": {
          "type": "object"
        }
      },
      "required": ["compare"],
      "additionalProperties": false
    },
    "apiThenFileExists": {
      "type": "object",
      "properties": {
        "file_exists": {
          "type": "string"
        }
      },
      "required": ["file_exists"],
      "additionalProperties": false
    },
    "apiThenFileAbsent": {
      "type": "object",
      "properties": {
        "file_absent": {
          "type": "string"
        }
      },
      "required": ["file_absent"],
      "additionalProperties": false
    },
    "apiThenServeImageOk": {
      "type": "object",
      "properties": {
        "serve_image_ok": {
          "type": "string"
        }
      },
      "required": ["serve_image_ok"],
      "additionalProperties": false
    },
    "apiThenThumb": {
      "type": "object",
      "properties": {
        "thumb_exists": {
          "description": "Hash variable whose generated thumbnail must exist."
        },
        "thumb_absent": {
          "description": "Hash variable whose generated thumbnail must not exist."
        }
      },
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false
    },
    "apiThenFileText": {
      "description": "Substring assertion on a text file in IMAGE_HOME.",
      "type": "object",
      "properties": {
        "file.contains": {
          "type": "string"
        },
        "file.not_contains": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": ["text"],
      "minProperties": 2,
      "maxProperties": 2,
      "additionalProperties": false
    },
    "apiThenItem": {
      "oneOf": [
        {
          "$ref": "#/definitions/apiThenResponseStatus"
        },
        {
          "$ref": "#/definitions/apiThenResponseStatusNot"
        },
        {
          "$ref": "#/definitions/apiThenResponseField"
        },
        {
          "$ref": "#/definitions/apiThenArrayMinCounts"
        },
        {
          "$ref": "#/definitions/apiThenArrayWhere"
        },
        {
          "$ref": "#/definitions/apiThenCompare"
        },
        {
          "$ref": "#/definitions/apiThenFileExists"
        },
        {
          "$ref": "#/definitions/apiThenFileAbsent"
        },
        {
          "$ref": "#/definitions/apiThenFileText"
        },
        {
          "$ref": "#/definitions/apiThenThumb"
        },
        {
          "$ref": "#/definitions/apiThenServeImageOk"
        },
        {
          "$ref": "#/definitions/apiThenResponseHeader"
        }
      ]
    },
    "apiWaitIndex": {
      "description": "Block until the running album index finishes, then probe GET /get/index/status.",
      "type": "object",
      "properties": {
        "wait_index": {
          "type": "boolean",
          "const": true
        }
      },
      "required": ["wait_index"],
      "additionalProperties": false
    },
    "whenItem": {
      "oneOf": [
        {
          "$ref": "#/definitions/apiCall"
        },
        {
          "$ref": "#/definitions/apiUpload"
        },
        {
          "$ref": "#/definitions/apiWriteFile"
        },
        {
          "$ref": "#/definitions/apiMintTimestampToken"
        },
        {
          "$ref": "#/definitions/givenDuplicateOf"
        },
        {
          "$ref": "#/definitions/apiWaitIndex"
        }
      ]
    },
    "apiWaitIndex": {
      "type": "object",
      "properties": {
        "wait_index": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "wait_index"
      ],
      "additionalProperties": false
    },
    "apiMintTimestampToken": {
      "type": "object",
      "properties": {
        "mint_timestamp_token": {
          "type": "object",
          "properties": {
            "as": {
              "type": "string",
              "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$"
            },
            "timestamp": {
              "type": "string"
            },
            "exp_offset": {
              "type": "integer",
              "default": 300
            }
          },
          "required": [
            "as",
            "timestamp"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "mint_timestamp_token"
      ],
      "additionalProperties": false
    },
    "apiScenario": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "given": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/givenItem"
          },
          "minItems": 0
        },
        "when": {
          "oneOf": [
            {
              "$ref": "#/definitions/whenItem"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/whenItem"
              },
              "minItems": 1
            }
          ]
        },
        "then": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/apiThenItem"
          },
          "minItems": 1
        }
      },
      "required": ["name", "when", "then"],
      "additionalProperties": false
    },
    "apiWriteFile": {
      "type": "object",
      "properties": {
        "write_file": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      },
      "required": ["write_file", "content"],
      "additionalProperties": false
    },
    "apiThenResponseHeader": {
      "type": "object",
      "patternProperties": {
        "^response\\.header\\.[A-Za-z0-9][A-Za-z0-9-]*$": {
          "type": "string"
        }
      },
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false
    }
  }
}
