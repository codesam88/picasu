{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API Scenario DSL Schema",
  "description": "Documents API scenario YAML files in tests/scenarios/ and tests/scenarios/selftest/. Enforced: `backend/src/tests/scenario_schema.rs` compiles this file and validates every scenario in both directories against it, and `cargo test -p picasu` runs that. Keep it in step with the interpreter — a form added to `backend/src/tests/backend_api.rs` without a definition here passes this check silently, and `scenario_schema::the_documented_response_assertion_forms_are_expressible` is the guard for the response-assertion forms. The check is a lower bound on the interpreter's acceptance, not an equality: a form the schema allows and the interpreter ignores passes here.",
  "$ref": "#/definitions/apiScenario",
  "definitions": {
    "givenDirAlbum": {
      "type": "object",
      "properties": {
        "dir_album": {
          "type": "string"
        },
        "id_as": {
          "type": "string",
          "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$"
        }
      },
      "required": ["dir_album"],
      "additionalProperties": false
    },
    "givenPhoto": {
      "type": "object",
      "properties": {
        "photo": {
          "type": "string"
        },
        "id_as": {
          "type": "string",
          "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exif_date": {
          "type": "string"
        },
        "color": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 3,
          "maxItems": 3
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "asset_id_as": {
          "description": "Bind the asset's API id to a variable. Independent of `id_as`: a photo may bind either or both, and either one is enough to resolve the identity.",
          "type": "string",
          "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "format": {
          "type": "string",
          "enum": ["jpeg", "png"],
          "default": "jpeg"
        }
      },
      "required": ["photo"],
      "additionalProperties": false
    },
    "givenRawFile": {
      "description": "Write UTF-8 text to a path. Binary content must use `fixture` or one of the byte transforms.",
      "type": "object",
      "properties": {
        "raw_file": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      },
      "required": ["raw_file"],
      "additionalProperties": false
    },
    "givenFixture": {
      "description": "Copy a capability-manifest fixture (digest-verified by snapfab's tests) into IMAGE_HOME.",
      "type": "object",
      "properties": {
        "fixture": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            },
            "destination": {
              "type": "string"
            }
          },
          "required": ["source", "destination"],
          "additionalProperties": false
        },
        "id_as": {
          "type": "string",
          "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "asset_id_as": {
          "type": "string",
          "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$"
        }
      },
      "required": ["fixture"],
      "additionalProperties": false
    },
    "givenRandomMedia": {
      "description": "Materialise the format the run's seed selected, as `<path>.<ext>`. The extension comes from the capability manifest, and the bytes are generated (jpeg, png) or copied from the pinned fixture the manifest names (tiff, webp, mp4, mov). Requires a top-level `randomize` block. Binds `${format}`, `${ext}` and `${mime}` from the selection so assertions never hard-code a format.",
      "type": "object",
      "properties": {
        "random_media": {
          "description": "Path stem; the selected format's canonical extension is appended.",
          "type": "string"
        },
        "id_as": {
          "type": "string",
          "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "asset_id_as": {
          "type": "string",
          "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$"
        }
      },
      "required": ["random_media"],
      "additionalProperties": false
    },
    "givenDuplicateOf": {
      "description": "Byte-identical copy of a file already placed in the given phase.",
      "type": "object",
      "properties": {
        "duplicate_of": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            },
            "destination": {
              "type": "string"
            }
          },
          "required": ["source", "destination"],
          "additionalProperties": false
        }
      },
      "required": ["duplicate_of"],
      "additionalProperties": false
    },
    "givenTruncateFile": {
      "description": "Keep only the first `bytes` bytes of a file the given phase already created. Applied after photo generation and before the scan, so the indexer sees the truncated bytes during its first pass.",
      "type": "object",
      "properties": {
        "truncate_file": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": ["path", "bytes"],
          "additionalProperties": false
        }
      },
      "required": ["truncate_file"],
      "additionalProperties": false
    },
    "givenPatchFile": {
      "description": "Replace the first occurrence of find_hex with replace_hex, in place. Applied after photo generation and before the scan. Find and replace must be the same length and the pattern must be present, so a corruption cannot be a silent no-op.",
      "type": "object",
      "properties": {
        "patch_file": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "find_hex": {
              "type": "string",
              "pattern": "^([0-9a-fA-F]{2})+$"
            },
            "replace_hex": {
              "type": "string",
              "pattern": "^([0-9a-fA-F]{2})+$"
            }
          },
          "required": ["path", "find_hex", "replace_hex"],
          "additionalProperties": false
        }
      },
      "required": ["patch_file"],
      "additionalProperties": false
    },
    "givenRemove": {
      "type": "object",
      "properties": {
        "remove": {
          "type": "string"
        }
      },
      "required": ["remove"],
      "additionalProperties": false
    },
    "givenEmpty": {
      "type": "object",
      "properties": {
        "empty": {
          "type": "boolean",
          "const": true
        }
      },
      "required": ["empty"],
      "additionalProperties": false
    },
    "givenConfig": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "properties": {
            "read_only_mode": {
              "type": "boolean"
            },
            "fs_notify_watcher": {
              "type": "boolean"
            },
            "validate_upload_content": {
              "type": "boolean"
            },
            "use_client_timestamp_info": {
              "type": "boolean"
            },
            "normalize_upload_filenames": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["config"],
      "additionalProperties": false
    },
    "givenItem": {
      "oneOf": [
        {
          "$ref": "#/definitions/givenDirAlbum"
        },
        {
          "$ref": "#/definitions/givenPhoto"
        },
        {
          "$ref": "#/definitions/givenRawFile"
        },
        {
          "$ref": "#/definitions/givenFixture"
        },
        {
          "$ref": "#/definitions/givenRandomMedia"
        },
        {
          "$ref": "#/definitions/givenDuplicateOf"
        },
        {
          "$ref": "#/definitions/givenTruncateFile"
        },
        {
          "$ref": "#/definitions/givenPatchFile"
        },
        {
          "$ref": "#/definitions/givenEmpty"
        },
        {
          "$ref": "#/definitions/givenRemove"
        },
        {
          "$ref": "#/definitions/givenConfig"
        }
      ]
    },
    "apiCall": {
      "type": "object",
      "properties": {
        "call": {
          "type": "string",
          "pattern": "^(GET|POST|PUT|DELETE) /"
        },
        "body": {
          "type": "object"
        },
        "raw_body": {
          "description": "Request body as a literal string; wins over `body`.",
          "type": "string"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "auth": {
          "type": "boolean",
          "default": true
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          }
        },
        "capture": {
          "type": "object"
        },
        "calc": {
          "type": "object"
        },
        "then": {
          "type": "array"
        },
        "id_as": {
          "description": "Resolve the asset's content hash by discover_path after this call.",
          "type": "string",
          "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "asset_id_as": {
          "description": "Resolve the asset_id by discover_path after this call.",
          "type": "string",
          "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "discover_path": {
          "type": "string"
        }
      },
      "required": ["call"],
      "additionalProperties": false
    },
    "apiUpload": {
      "type": "object",
      "properties": {
        "upload": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            },
            "filename": {
              "type": "string"
            },
            "target_album": {
              "type": "string"
            },
            "on_conflict": {
              "type": "string",
              "enum": ["rename", "skip"]
            },
            "auto_rename": {
              "type": "boolean"
            },
            "last_modified": {
              "type": "integer"
            },
            "auth": {
              "type": "boolean"
            },
            "content_type": {
              "type": "string"
            }
          },
          "required": ["file"],
          "additionalProperties": false
        },
        "then": {
          "type": "array"
        },
        "id_as": {
          "type": "string",
          "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "asset_id_as": {
          "description": "Bind the uploaded asset's API id to a variable. Bound after a non-final `when` step exactly as on a `call`, through `discover_path`.",
          "type": "string",
          "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "discover_path": {
          "type": "string"
        }
      },
      "required": ["upload"],
      "additionalProperties": false
    },
    "apiThenResponseStatus": {
      "type": "object",
      "properties": {
        "response.status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        }
      },
      "required": ["response.status"],
      "additionalProperties": false
    },
    "apiThenResponseStatusNot": {
      "type": "object",
      "properties": {
        "response.status_not": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        }
      },
      "required": ["response.status_not"],
      "additionalProperties": false
    },
    "apiThenResponseField": {
      "description": "One `response.json.<path>` equality assertion. The `response.json.` prefix is required rather than conventional: `backend_api.rs` dispatches a body assertion only for a key that starts with it, so a bare `response.<path>` in a `then:` list would be read and silently dropped, and the schema must not admit a form that asserts nothing. The path allows `:` and `-` inside segments because ffprobe-derived video exifVec keys are literally named e.g. `TAG:major_brand` and `TAG:compatible_brands`, and `[n]` because `navigate_json` walks array indices.",
      "type": "object",
      "patternProperties": {
        "^response\\.json\\.[A-Za-z0-9_.:\\[\\]-]+$": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            },
            {
              "type": "object"
            },
            {
              "type": "array"
            }
          ]
        }
      },
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false
    },
    "apiThenArrayMinCounts": {
      "type": "object",
      "properties": {
        "array_min_counts": {
          "type": "object"
        }
      },
      "required": ["array_min_counts"],
      "additionalProperties": false
    },
    "apiThenArrayWhere": {
      "type": "object",
      "properties": {
        "array_where": {
          "type": "object"
        }
      },
      "required": ["array_where"],
      "additionalProperties": false
    },
    "apiThenCompare": {
      "type": "object",
      "properties": {
        "compare": {
          "type": "object"
        }
      },
      "required": ["compare"],
      "additionalProperties": false
    },
    "apiThenFileExists": {
      "description": "The named path must exist under IMAGE_HOME. The path is IMAGE_HOME-relative with an optional leading `/`, and `${var}` interpolation applies; a path that interpolates to an absolute one (e.g. `${data_path}/...`) resolves to a location that cannot exist, so the harness rejects it instead of letting the assertion pass vacuously.",
      "type": "object",
      "properties": {
        "file_exists": {
          "type": "string"
        }
      },
      "required": ["file_exists"],
      "additionalProperties": false
    },
    "apiThenFileAbsent": {
      "description": "The named path must not exist under IMAGE_HOME. IMAGE_HOME-relative with an optional leading `/`, `${var}` interpolation applies, and an absolute interpolated path is rejected, see apiThenFileExists.",
      "type": "object",
      "properties": {
        "file_absent": {
          "type": "string"
        }
      },
      "required": ["file_absent"],
      "additionalProperties": false
    },
    "apiThenServeImageOk": {
      "description": "Fetch the compressed thumbnail for a content-hash variable ($name bound by `id_as`) through GET /object/compressed/<hash[0:2]>/<hash>.jpg and require 200, an `image/jpeg` content type and JPEG bytes. Status alone is not asserted: a handler can answer 200 with an error page.",
      "type": "object",
      "properties": {
        "serve_image_ok": {
          "type": "string"
        }
      },
      "required": ["serve_image_ok"],
      "additionalProperties": false
    },
    "apiThenThumb": {
      "type": "object",
      "properties": {
        "thumb_exists": {
          "description": "Hash variable whose generated thumbnail must exist."
        },
        "thumb_absent": {
          "description": "Hash variable whose generated thumbnail must not exist."
        }
      },
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false
    },
    "apiThenFileText": {
      "description": "Substring assertion on a text file in IMAGE_HOME.",
      "type": "object",
      "properties": {
        "file.contains": {
          "type": "string"
        },
        "file.not_contains": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": ["text"],
      "minProperties": 2,
      "maxProperties": 2,
      "additionalProperties": false
    },
    "apiThenItem": {
      "oneOf": [
        {
          "$ref": "#/definitions/apiThenResponseStatus"
        },
        {
          "$ref": "#/definitions/apiThenResponseStatusNot"
        },
        {
          "$ref": "#/definitions/apiThenResponseField"
        },
        {
          "$ref": "#/definitions/apiThenArrayMinCounts"
        },
        {
          "$ref": "#/definitions/apiThenArrayWhere"
        },
        {
          "$ref": "#/definitions/apiThenCompare"
        },
        {
          "$ref": "#/definitions/apiThenFileExists"
        },
        {
          "$ref": "#/definitions/apiThenFileAbsent"
        },
        {
          "$ref": "#/definitions/apiThenFileText"
        },
        {
          "$ref": "#/definitions/apiThenThumb"
        },
        {
          "$ref": "#/definitions/apiThenServeImageOk"
        },
        {
          "$ref": "#/definitions/apiThenResponseHeader"
        }
      ]
    },
    "apiWaitIndex": {
      "description": "Block until the running album index settles on `completed`, then probe GET /get/index/status. A scan that settles on any other state (a failed index panics the harness while the given phase waits) is not expressible here.",
      "type": "object",
      "properties": {
        "wait_index": {
          "type": "boolean",
          "const": true
        }
      },
      "required": ["wait_index"],
      "additionalProperties": false
    },
    "whenItem": {
      "oneOf": [
        {
          "$ref": "#/definitions/apiCall"
        },
        {
          "$ref": "#/definitions/apiUpload"
        },
        {
          "$ref": "#/definitions/apiWriteFile"
        },
        {
          "$ref": "#/definitions/apiMintTimestampToken"
        },
        {
          "$ref": "#/definitions/givenDuplicateOf"
        },
        {
          "$ref": "#/definitions/apiWaitIndex"
        },
        {
          "$ref": "#/definitions/apiChmod"
        }
      ]
    },
    "apiMintTimestampToken": {
      "type": "object",
      "properties": {
        "mint_timestamp_token": {
          "type": "object",
          "properties": {
            "as": {
              "type": "string",
              "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$"
            },
            "timestamp": {
              "type": "string"
            },
            "exp_offset": {
              "type": "integer",
              "default": 300
            }
          },
          "required": [
            "as",
            "timestamp"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "mint_timestamp_token"
      ],
      "additionalProperties": false
    },
    "apiChmod": {
      "description": "Change the POSIX permissions of a path the given phase placed, so a scenario can watch the server meet a filesystem that refuses a read or a write. A `when` step rather than a `given` transform: the given phase's own index scan has to see the file first. Unix only — the interpreter panics on any other platform.",
      "type": "object",
      "properties": {
        "chmod": {
          "type": "object",
          "properties": {
            "path": {
              "description": "IMAGE_HOME-relative path, with or without a leading `/`.",
              "type": "string"
            },
            "octal": {
              "description": "The mode in the `chmod` spelling, e.g. `\"0500\"` to remove write permission, `\"0200\"` to keep only write.",
              "type": "string",
              "pattern": "^0[0-7]{3,4}$"
            }
          },
          "required": ["path", "octal"],
          "additionalProperties": false
        }
      },
      "required": ["chmod"],
      "additionalProperties": false
    },
    "apiScenario": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "randomize": {
          "description": "Opt into seeded format selection. The scenario then runs once per seed in the named set, each pass materialising `random_media` in the format that seed resolves to. `PICASU_RANDOM_SEEDS` overrides the set with a set name or a comma-separated seed list; unset, the scenario runs exactly its named set (the fixed `ci` set by default).",
          "type": "object",
          "properties": {
            "seeds": {
              "description": "A set name from backend/tests/seeds.json. Defaults to `ci`.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "given": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/givenItem"
          },
          "minItems": 0
        },
        "when": {
          "oneOf": [
            {
              "$ref": "#/definitions/whenItem"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/whenItem"
              },
              "minItems": 1
            }
          ]
        },
        "then": {
          "description": "Assertions on the last `when` step's response. Required, because the interpreter reads it unconditionally, but an empty list is accepted: a scenario whose assertions all sit in a non-final step's own `then:` has nothing left to assert here, and the interpreter treats an empty block as a no-op.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/apiThenItem"
          },
          "minItems": 0
        }
      },
      "required": ["name", "when", "then"],
      "additionalProperties": false
    },
    "apiWriteFile": {
      "type": "object",
      "properties": {
        "write_file": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      },
      "required": ["write_file", "content"],
      "additionalProperties": false
    },
    "apiThenResponseHeader": {
      "type": "object",
      "patternProperties": {
        "^response\\.header\\.[A-Za-z0-9][A-Za-z0-9-]*$": {
          "type": "string"
        }
      },
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false
    }
  }
}
